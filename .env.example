# Copy to apps/hub/.env.local, apps/build/.env.local, and apps/defend/.env.local

# AI chatbot (hub, build, defend)
AI_PROVIDER=openai
OPENAI_API_KEY=

# Optional: Gemini instead of OpenAI
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash-latest

# Contact form (hub only) — Google Apps Script web app URL
GOOGLE_APPS_SCRIPT_URL=

# Defend chatbot — set true so /api/chat on defend accepts requests (requires AI keys above).
# Set to false to keep the API disabled even if keys are present.
# If unset, the API is enabled whenever OPENAI_API_KEY or GEMINI_API_KEY is set.
ENABLE_DEFEND_CHAT=true
