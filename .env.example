# Copy to apps/hub/.env.local and apps/build/.env.local (and apps/defend when chat is enabled)

# AI chatbot (hub + build)
AI_PROVIDER=openai
OPENAI_API_KEY=

# Optional: Gemini instead of OpenAI
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash-latest

# Contact form (hub only) — Google Apps Script web app URL
GOOGLE_APPS_SCRIPT_URL=

# Defend chatbot (enable after cyber site migration)
# ENABLE_DEFEND_CHAT=true
