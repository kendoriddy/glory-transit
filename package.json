{
  "name": "portfolio-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "dev:hub": "turbo run dev --filter=hub",
    "dev:build": "turbo run dev --filter=build",
    "dev:defend": "turbo run dev --filter=defend"
  },
  "devDependencies": {
    "lottie-react": "^2.4.0",
    "turbo": "^2.3.3",
    "typescript": "^5.5.4"
  },
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "shiplocal": "^0.1.5"
  }
}
